# Copy to .env for local development. On Cloud Run, set these as environment
# variables / Secret Manager secrets instead. Never commit .env.

# --- MySQL --------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cit_scheduler
DB_USER=cit
DB_PASSWORD=
# Cloud SQL from Cloud Run: use the socket instead of host/port
# DB_SOCKET=/cloudsql/PROJECT:REGION:INSTANCE
# Managed MySQL that requires TLS (e.g. Aiven): path to the CA certificate
# DB_SSL_CA=/app/certs/ca.pem

# --- Engine -------------------------------------------------------------
# Python with OR-Tools (the Docker image sets /opt/venv/bin/python). Without OR-Tools the
# engine still works with its built-in search, just with higher soft penalties.
PYTHON_BIN=python3

# --- App ----------------------------------------------------------------
# 1 shows error details in API responses (never in production)
APP_DEBUG=0
TEAM_NAME=
# Password for all demo accounts (min 8 chars). Shared with judges in the README.
DEMO_PASSWORD=
# Week-7 weekday that "today" / "kal" resolve against (MON..FRI)
REFERENCE_WEEKDAY=MON

# --- AI (optional; manual booking works without it) ---------------------
# LLM_PROVIDER=openai  -> any OpenAI-compatible API (OpenAI, Gemini, Groq, OpenRouter); set LLM_BASE_URL if not OpenAI
#   Gemini example: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_PROVIDER=anthropic -> Anthropic Messages API
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Embeddings for RAG (OpenAI-compatible /embeddings). Empty = keyword search only.
EMBED_BASE_URL=
EMBED_MODEL=
EMBED_API_KEY=

# --- Tests only ---------------------------------------------------------
# Set to 1 to allow database/tests/test_db.php to wipe the configured database
CIT_ALLOW_DESTRUCTIVE_TESTS=0
